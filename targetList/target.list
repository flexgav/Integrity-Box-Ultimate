# IntegrityBox Ultimate - attestation target list (auto mode)
#
# Lines starting with '#' and blank lines are ignored.
# Core Google packages are always written to target.txt regardless of
# install state (handled by a fixed case statement in target.sh).
# All other packages are written only if installed on the device.

com.google.android.gms
com.android.vending
com.google.android.gsf
com.google.android.apps.walletnfcrel

# Optional Google packages
com.google.android.safetycore
com.google.android.contactkeys
com.google.android.apps.nbu.paisa.user

# PIF / Key Attestation checkers
io.github.vvb2060.keyattestation
io.github.qwq233.keyattestation
io.github.kukushivan.keyboxchecker
com.flexgavna.keybox
gr.nikolasspyr.integritycheck
org.akanework.checker
com.example.snichecker
krypton.tbsafetychecker

